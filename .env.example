# ---- Application ----
APP_NAME=Incident Memory Engine
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Datastores ----
# Local docker-compose default. For MongoDB Atlas use your SRV connection string.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=incident_memory
# Redis: set REDIS_URL for a local/self-hosted server...
REDIS_URL=redis://localhost:6379/0
# ...or leave REDIS_URL empty and set these two for Upstash (the REST token is
# also the database password, so the TCP URL is derived from them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vector store. Create a Dense index with 384 dimensions, COSINE, and no hosted
# embedding model — this app sends its own vectors.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ---- Storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=209715200
ALLOWED_UPLOAD_EXTENSIONS=.log,.txt,.json,.ndjson

# ---- Auth ----
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Ingestion ----
READ_CHUNK_BYTES=1048576
EVENT_BULK_BATCH=500

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
# Idle poll length. Raise it (15-30) on metered Redis so an idle worker burns fewer commands.
EMBEDDING_BLOCK_SECONDS=2
# Only embed events at or above this level. Lower levels stay keyword-searchable in
# Mongo. This is the main lever on daily vector-upsert spend.
EMBED_MIN_LEVEL=WARN

# ---- Vector free-tier budget (per UTC day) ----
VECTOR_DAILY_QUERY_LIMIT=10000
VECTOR_DAILY_UPDATE_LIMIT=10000

# ---- Clustering ----
CLUSTER_INTERVAL_SECONDS=900
CLUSTER_EPS=0.35
CLUSTER_MIN_SAMPLES=3
CLUSTER_MAX_EVENTS=20000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
