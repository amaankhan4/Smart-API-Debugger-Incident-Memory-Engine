{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev stack (all services)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "API only (debug breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Embedding worker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.workers.embedding_workers",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Clustering worker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.workers.clustering_worker",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
